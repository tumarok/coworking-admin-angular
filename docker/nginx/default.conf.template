# Rendered by the official image at start-up: ${API_UPSTREAM} comes from the environment, every
# other $name stays an nginx variable.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/javascript application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # The API. nginx resolves the upstream host once, at start-up.
    location ^~ /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The shell names the hashed files, so it is the one file that must always be revalidated.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Built files carry a content hash in their name (chunk-AbC12_-x.js): cache for good. A missing
    # one is a 404, not the app shell.
    location ~ "-[A-Za-z0-9_-]{8}\.(?:js|css|woff2?)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Other files of public/ keep their names, so they may change: a day, then revalidate.
    location ~* \.(?:ico|png|svg|jpe?g|webp|gif|woff2?|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Any other path is a route of the app (or a bad address the app words as 404).
    location / {
        try_files $uri /index.html;
    }
}
