{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The suite drives the built app from outside: it imports nothing of it.
    "paths": {},
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
